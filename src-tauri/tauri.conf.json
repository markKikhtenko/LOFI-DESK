{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LOFI DESK",
  "version": "0.2.1",
  "identifier": "com.markkikhtenko.lofidesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOFI DESK",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://ice5.somafm.com https://ice6.somafm.com https://ice2.somafm.com https://somafm.com https://github.com; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: https://ice5.somafm.com https://ice6.somafm.com https://ice2.somafm.com; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Локальная музыка и интернет-радио для спокойной работы",
    "longDescription": "LOFI DESK объединяет локальную музыкальную медиатеку и открытые интернет-радиостанции в минималистичном настольном плеере.",
    "copyright": "Copyright © 2026 Mark Kikhtenko",
    "publisher": "Mark Kikhtenko",
    "homepage": "https://github.com/markKikhtenko/LOFI-DESK",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "LOFI DESK",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/markKikhtenko/LOFI-DESK/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NzIxOURBM0MwODc3MzMKUldRemR3ZzgyaGx5OXQzSDAxV0s3MjVMdWlTbWxhT0k5enlLUkNHOTc0cWtMcytGMjlDUjNkcUwK",
      "windows": { "installMode": "passive" }
    }
  }
}
